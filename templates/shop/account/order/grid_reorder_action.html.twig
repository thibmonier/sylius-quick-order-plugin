<form method="post" action="{{ path('tmonier_quick_order_shop_reorder', {'number': data.number}) }}" class="d-inline m-0">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_quick_order') }}">
    <button type="submit" class="btn btn-sm btn-outline-gray" {{ sylius_test_html_attribute('tmonier-quick-order-reorder-' ~ data.number) }}>
        {{ ux_icon(action.options.icon|default('tabler:shopping-cart-plus'), {'class': 'icon'}) }}
        {{ action.label|trans }}
    </button>
</form>
