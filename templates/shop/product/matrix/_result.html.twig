{% set added = result.countAdded %}
{% if result.refusal %}
    <div class="alert alert-danger" role="alert" {{ sylius_test_html_attribute('tmonier-quick-order-matrix-result') }}>
        {{ ('tmonier_quick_order.refusal.' ~ result.refusal)|trans({'%max%': this.maxTotalQuantity, '%lines%': 0}, 'flashes') }}
    </div>
{% elseif result.applied %}
    <div class="alert {{ result.hasErrors ? 'alert-warning' : 'alert-success' }}" role="status" {{ sylius_test_html_attribute('tmonier-quick-order-matrix-result') }}>
        {{ 'tmonier_quick_order.ui.result_applied'|trans({'%count%': added}) }}
        {% if result.hasErrors %}&middot; {{ 'tmonier_quick_order.ui.matrix.fix_errors'|trans }}{% endif %}
        <a class="alert-link ms-2" href="{{ path('sylius_shop_cart_summary') }}">{{ 'sylius.ui.view_and_edit_cart'|trans }}</a>
    </div>
{% else %}
    <div class="alert alert-danger" role="alert" {{ sylius_test_html_attribute('tmonier-quick-order-matrix-result') }}>
        {{ 'tmonier_quick_order.ui.result_not_applied'|trans }} &middot; {{ 'tmonier_quick_order.ui.matrix.fix_errors'|trans }}
    </div>
{% endif %}
