<div class="card mb-4" {{ sylius_test_html_attribute('tmonier-quick-order-result') }}>
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-bold">
            {% if result.applied %}
                {{ 'tmonier_quick_order.ui.result_applied'|trans({'%count%': result.countAdded}) }}
            {% else %}
                {{ 'tmonier_quick_order.ui.result_not_applied'|trans }}
            {% endif %}
        </span>
        {% if result.refusal %}
            <span class="text-danger small">{{ ('tmonier_quick_order.refusal.' ~ result.refusal)|trans({}, 'flashes') }}</span>
        {% endif %}
    </div>
    {% include '@TmonierSyliusQuickOrderPlugin/shop/quick_order/_lines.html.twig' with {lines_to_show: result.lines} %}
    <div class="card-footer d-flex flex-wrap gap-2">
        {% if result.applied %}
            <a class="btn btn-primary" href="{{ path('sylius_shop_cart_summary') }}">{{ 'sylius.ui.view_and_edit_cart'|trans }}</a>
        {% endif %}
        <a class="btn btn-outline-gray" href="{{ path('tmonier_quick_order_shop_report') }}" {{ sylius_test_html_attribute('tmonier-quick-order-report') }}>
            {{ 'tmonier_quick_order.ui.download_report'|trans }}
        </a>
    </div>
</div>
